{
  "name": "crawlfetcher",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "generate-integration-types": "node _integrationGen.ts",
    "prepare": "node _integrationGen.ts",
    "postinstall": "PLAYWRIGHT_BROWSERS_PATH=0 npx playwright install firefox",
    "start": "PLAYWRIGHT_BROWSERS_PATH=0 node _start.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "npx biome check --write .",
    "typecheck": "npx tsc --noEmit"
  },
  "dependencies": {
    "@ghostery/adblocker-playwright": "latest",
    "playwright": "latest",
    "sharp": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/node": "latest",
    "typescript": "latest"
  }
}
